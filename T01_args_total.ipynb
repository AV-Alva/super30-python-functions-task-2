    "def calculate_total(*args):\n",
    "    \"\"\"Return the total of any number of supplied values.\"\"\"\n",
    "    total = 0\n",
    "\n",
    "    for number in args:\n",
    "        total = total + number\n",
    "\n",
    "    return total\n",
    "\n",
    "\n",
    "print(\"2 arguments:\", calculate_total(10, 20))\n",
    "print(\"4 arguments:\", calculate_total(10, 20, 30, 40))"
   ]
  },
