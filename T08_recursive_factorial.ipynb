   "source": [
    "def factorial(number):\n",
    "    \"\"\"Return factorial using recursion.\"\"\"\n",
    "    if number == 0 or number == 1:\n",
    "        return 1\n",
    "\n",
    "    return number * factorial(number - 1)\n",
    "\n",
    "\n",
    "print(\"Factorial of 5:\", factorial(5))"
   ]
