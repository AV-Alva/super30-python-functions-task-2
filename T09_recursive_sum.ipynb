   "source": [
    "def recursive_sum(number):\n",
    "    \"\"\"Return the sum from 1 to number using recursion.\"\"\"\n",
    "    if number <= 1:\n",
    "        return number\n",
    "\n",
    "    return number + recursive_sum(number - 1)\n",
    "\n",
    "\n",
    "print(\"Sum from 1 to 5:\", recursive_sum(5))"
   ]
