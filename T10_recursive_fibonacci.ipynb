   "source": [
    "def fibonacci(number):\n",
    "    \"\"\"Return the nth Fibonacci number using recursion.\"\"\"\n",
    "    if number == 0:\n",
    "        return 0\n",
    "\n",
    "    if number == 1:\n",
    "        return 1\n",
    "\n",
    "    return fibonacci(number - 1) + fibonacci(number - 2)\n",
    "\n",
    "\n",
    "print(\"Fibonacci of 6:\", fibonacci(6))"
   ]
  }
 ],
